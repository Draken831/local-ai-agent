# Cloud-first execution
AI_PROVIDER_ORDER=cloud,local

# Primary cloud provider
CLOUD_AI_ENABLED=true
CLOUD_API_STYLE=responses
CLOUD_API_BASE_URL=https://api.openai.com/v1
CLOUD_API_KEY=
CLOUD_TIMEOUT_CONNECT=3
CLOUD_TIMEOUT_READ=15
CLOUD_RETRIES=0
CLOUD_CIRCUIT_BREAKER_FAILURES=2
CLOUD_CIRCUIT_BREAKER_SECONDS=30
CLOUD_MAX_RESPONSE_TOKENS=900
CLOUD_WEB_SEARCH_ENABLED=true

# Cloud model routing
CLOUD_MODEL_FAST=gpt-5.6-luna
CLOUD_MODEL_DEEP=gpt-5.6-terra
CLOUD_MODEL_CODE=gpt-5.6-terra
CLOUD_MODEL_DOC=gpt-5.6-luna
CLOUD_MODEL_RESEARCH=gpt-5.6-luna
CLOUD_MODEL_VISION=gpt-5.6-luna
CLOUD_MODEL_FORCE=

# Cloud embeddings first; local fallback if unavailable
CLOUD_EMBEDDINGS_ENABLED=true
CLOUD_EMBEDDING_MODEL=text-embedding-3-small

# Local fallback
LOCAL_FALLBACK_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
LOCAL_REQUEST_TIMEOUT=180
LOCAL_MODEL_FAST=llama3.2:3b
LOCAL_MODEL_DEEP=qwen2.5:7b
LOCAL_MODEL_CODE=qwen2.5-coder:7b
LOCAL_MODEL_DOC=llama3.2:3b
LOCAL_MODEL_RESEARCH=llama3.2:3b
LOCAL_MODEL_VISION=llama3.2-vision
LOCAL_MODEL_FORCE=
LOCAL_EMBEDDING_MODEL=nomic-embed-text

# Backward-compatible names retained for v4 overlays
OLLAMA_MODEL=llama3.2:3b
REQUEST_TIMEOUT=180
MAX_RESPONSE_TOKENS=900
DYNAMIC_MODEL_ROUTING=true
DYNAMIC_MODEL_ANNOUNCE=true
MODEL_FAST=llama3.2:3b
MODEL_DEEP=qwen2.5:7b
MODEL_CODE=qwen2.5-coder:7b
MODEL_DOC=llama3.2:3b
MODEL_RESEARCH=llama3.2:3b
MODEL_FORCE=
VISION_MODEL=llama3.2-vision
EMBEDDING_MODEL=nomic-embed-text

# Research / document behavior
SEARXNG_BASE_URL=http://127.0.0.1:8080
ONLINE_FIRST_MODE=false
ONLINE_RESEARCH_MAX_RESULTS=5
ONLINE_RESEARCH_FETCH_TOP=3
ALLOW_PRIVATE_URLS=true

DOCUMENT_MAX_CHARS=16000
DOCUMENT_CONTEXT_CHARS=7000
DOCUMENT_CACHE_ENABLED=true
DOCUMENT_UPLOAD_ROOT=data/uploads
OCR_ENABLED=true
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

DEFAULT_OUTPUT_PATH=C:\NSU
SCRIPT_LOG_PATH=C:\NSU
ALLOW_DESTRUCTIVE_ACTIONS=false
REQUIRE_CONFIRMATION_FOR_HIGH_RISK=true
